{
  "mcpServers": {
    "hostinger-api": {
      "command": "cmd",
      "args": ["/c", "hostinger-api-mcp"],
      "env": {
        "DEBUG": "false",
        "API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "supabase": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=zstiqoqvovryhkytawzr"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
