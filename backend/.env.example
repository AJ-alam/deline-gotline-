# ─── Django Core ───────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=EptDBX8aNlod8kUSKvBGQsfDtFa6To-0h9TNSsQg8ldQ_f72g94ZZfDV0lM1gYyhSoQ

# Never set DEBUG=True in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app,.supabase.co

# ─── Database ──────────────────────────────────────────────────────────────
# Production: PostgreSQL (Supabase Transaction Pooler — port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# ─── Supabase Storage ──────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=dgg-documents

# ─── Frontend URLs (for CORS & redirect links) ─────────────────────────────
FRONTEND_URL=https://your-vercel-deployment.vercel.app
FRONTEND_URL_ALT=http://localhost:5173

# ─── Vercel deployment (optional — auto-injected by Vercel) ────────────────
# VERCEL_URL=your-deployment-url.vercel.app

# ─── CSRF Trusted Origins ──────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://your-vercel-deployment.vercel.app,http://localhost:5173

# ─── Email (SMTP via Gmail App Password) ───────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=DGG Student Funding <noreply@deline.ca>

# ─── Finance email recipient ────────────────────────────────────────────────
FINANCE_EMAIL=finance@yourorg.ca
SENDER_EMAIL=your-sender@gmail.com
SENDER_PASSWORD=your-gmail-app-password
