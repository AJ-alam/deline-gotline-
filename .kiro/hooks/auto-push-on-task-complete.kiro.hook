{
  "enabled": true,
  "name": "Auto Push to GitHub on Task Complete",
  "description": "After each spec task is marked completed, stages all changes, creates a commit with the task name, and pushes to GitHub",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "\"C:\\Program Files\\Git\\bin\\git.exe\" add -A && \"C:\\Program Files\\Git\\bin\\git.exe\" commit -m \"feat: completed spec task\" && \"C:\\Program Files\\Git\\bin\\git.exe\" push -u origin master",
    "timeout": 120
  },
  "workspaceFolderName": "deline-gotline--main",
  "shortName": "auto-push-on-task-complete"
}