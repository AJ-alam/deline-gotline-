# ─── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ─── Python / Backend ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
venv/
backend/venv/
.venv/
env/
*.pyc

# ─── Django ────────────────────────────────────────────────────────────────
# Catch every local database file. The explicit db.sqlite3 entries missed
# dev.sqlite3, which ended up committed with real (if throwaway) user rows.
*.sqlite3
backend/db.sqlite3
db.sqlite3
# And every copy taken before a migration. `*.sqlite3` does not match
# `db.sqlite3.backup-20260816`, so a database set aside for safety was the one
# thing in the directory git offered to commit.
*.sqlite3.*
backend/staticfiles/
staticfiles/
backend/media/
*.log
backend/*.log

# ─── Environment & Secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Database dumps / backups ──────────────────────────────────────────────
*.json.bak
backend/data_backup.json
*.dump
# Pre-reset snapshots — full of personal data, must never be committed
backups/

# ─── Build artifacts ───────────────────────────────────────────────────────
index-*.js
index-*.css
*.map

# ─── Testing / Coverage ────────────────────────────────────────────────────
.pytest_cache/
backend/.pytest_cache/
coverage/
*.coverage
htmlcov/

# ─── Code analysis tools ───────────────────────────────────────────────────
.graphify*
graphify-out/
graphify_*/

# ─── Editor / OS ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Deployment ────────────────────────────────────────────────────────────
.vercel/

.vercel

